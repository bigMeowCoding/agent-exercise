# https://platform.moonshot.cn/console/api-keys
MOONSHOT_API_KEY=你的 apiKey
# 可选，默认 kimi-k2.6；可用模型见 GET https://api.moonshot.cn/v1/models
# KIMI_MODEL=kimi-k3

# Embedding 服务（Moonshot 不提供 Embedding，任选一个 OpenAI 兼容服务），rag-memory-store 示例需要
# 例：硅基流动 https://cloud.siliconflow.cn/account/ak ，BAAI/bge-m3 免费
EMBEDDINGS_API_KEY=你的 apiKey
EMBEDDINGS_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDINGS_MODEL_NAME=BAAI/bge-m3
